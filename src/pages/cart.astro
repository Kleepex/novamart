---
import StoreLayout from '../layouts/StoreLayout.astro';
import { getProducts } from '../lib/db';

const products = getProducts();
---

<StoreLayout title="Your cart — NovaMart Stores">
  <h1 style="margin: 2rem 0 1.25rem; letter-spacing: -0.01em">Your cart</h1>

  <div class="panel empty" id="cart-empty" hidden>
    <div class="big">🛒</div>
    <h2>Your cart is empty</h2>
    <p>Browse the store and add a few essentials.</p>
    <p style="margin-top: 1rem"><a class="btn btn--primary" href="/">Continue shopping</a></p>
  </div>

  <div id="cart-full" hidden>
    <div style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.5rem; align-items: start" class="cart-grid">
      <div class="panel" style="padding: 0.5rem 1.25rem;">
        <table class="tbl" aria-label="Cart items">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th class="num">Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="cart-body"></tbody>
        </table>
      </div>

      <aside class="panel">
        <h2>Order summary</h2>
        <div class="totals">
          <div class="row"><span>Subtotal</span><span id="sum-sub">₦0</span></div>
          <div class="row"><span>Delivery</span><span>Calculated at checkout</span></div>
          <div class="row grand"><span>Total</span><span id="sum-total">₦0</span></div>
        </div>
        <a href="/checkout" class="btn btn--amber btn--lg btn--block" style="margin-top: 1.25rem">
          Proceed to checkout
        </a>
        <a href="/" class="btn btn--ghost btn--block" style="margin-top: 0.6rem">Continue shopping</a>
      </aside>
    </div>
  </div>

  <script id="nm-products" type="application/json" set:html={JSON.stringify(products)}></script>
  <script>
    (() => {
      const catalog = JSON.parse(document.getElementById('nm-products').textContent);
      const byId = Object.fromEntries(catalog.map((p) => [p.id, p]));
      const body = document.getElementById('cart-body');
      const naira = (n) => '₦' + n.toLocaleString('en-NG');

      const render = () => {
        const cart = window.NMCart.read();
        const ids = Object.keys(cart).filter((id) => byId[id]);
        const has = ids.length > 0;
        document.getElementById('cart-empty').hidden = has;
        document.getElementById('cart-full').hidden = !has;
        if (!has) return;

        let subtotal = 0;
        body.innerHTML = ids
          .map((id) => {
            const p = byId[id];
            const qty = cart[id];
            const line = p.price * qty;
            subtotal += line;
            return `<tr>
              <td><b>${p.name}</b><br><span style="color:var(--ink-mute);font-size:0.84rem">${p.category}</span></td>
              <td>${naira(p.price)}</td>
              <td>
                <span class="qty-ctl">
                  <button data-dec="${id}" aria-label="Decrease">−</button>
                  <input value="${qty}" data-qty="${id}" aria-label="Quantity" />
                  <button data-inc="${id}" aria-label="Increase">+</button>
                </span>
              </td>
              <td class="num"><b>${naira(line)}</b></td>
              <td><button class="link-danger" data-remove="${id}">Remove</button></td>
            </tr>`;
          })
          .join('');
        document.getElementById('sum-sub').textContent = naira(subtotal);
        document.getElementById('sum-total').textContent = naira(subtotal);
      };

      document.addEventListener('click', (e) => {
        const t = e.target;
        const cart = window.NMCart.read();
        if (t.dataset?.inc) { cart[t.dataset.inc] = Math.min(99, (cart[t.dataset.inc] || 1) + 1); window.NMCart.write(cart); render(); }
        else if (t.dataset?.dec) { cart[t.dataset.dec] = Math.max(1, (cart[t.dataset.dec] || 1) - 1); window.NMCart.write(cart); render(); }
        else if (t.dataset?.remove) { delete cart[t.dataset.remove]; window.NMCart.write(cart); render(); window.NMToast('Removed from cart'); }
      });

      render();
    })();
  </script>
</StoreLayout>

<style>
  @media (max-width: 860px) {
    .cart-grid { grid-template-columns: 1fr !important; }
  }
</style>
