---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listOrders } from '../../../lib/db';
import { naira, fmtDate, STATUS_COLORS, ORDER_STATUSES } from '../../../lib/format';

const status = Astro.url.searchParams.get('status') ?? '';
const saved = Astro.url.searchParams.get('saved');
const orders = listOrders().filter((o) => !status || o.status === status);

const chip = (label, value) =>
  `<a class="chip ${status === value ? 'is-active' : ''}" href="/admin/orders${value ? '?status=' + value : ''}">${label}</a>`;
---

<AdminLayout title="Orders" subtitle={`${orders.length} order${orders.length === 1 ? '' : 's'}${status ? ' — ' + status : ''}`} active="orders">
  {saved && <div class="notice notice--ok">Order status updated. ✅</div>}

  <div class="chip-bar" style="margin-top:0">
    <Fragment set:html={chip('All', '')} />
    {ORDER_STATUSES.map((s) => <Fragment set:html={chip(s, s)} />)}
  </div>

  <div class="panel" style="padding: 0.5rem 1.25rem">
    {
      orders.length === 0 ? (
        <div class="empty">
          <div class="big">📦</div>
          <h2>No orders here yet</h2>
          <p>New orders from the storefront will appear here.</p>
        </div>
      ) : (
        <table class="tbl">
          <thead>
            <tr><th>Ref</th><th>Customer</th><th>Items</th><th class="num">Total</th><th>Status</th><th>Placed</th><th></th></tr>
          </thead>
          <tbody>
            {orders.map((o) => (
              <tr>
                <td><a href={`/admin/orders/${o.ref}`} style="font-weight:700">{o.ref}</a></td>
                <td>{o.customer}<br /><span style="color:var(--ink-mute);font-size:0.84rem">{o.phone}</span></td>
                <td style="color:var(--ink-soft)">{o.items.reduce((s, i) => s + i.qty, 0)}</td>
                <td class="num"><b>{naira(o.total)}</b></td>
                <td><span class="badge" style={`background:${STATUS_COLORS[o.status]}18;color:${STATUS_COLORS[o.status]}`}>{o.status}</span></td>
                <td style="color:var(--ink-mute);font-size:0.85rem">{fmtDate(o.createdAt)}</td>
                <td class="num"><a href={`/admin/orders/${o.ref}`} class="btn btn--ghost btn--sm">View</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</AdminLayout>
