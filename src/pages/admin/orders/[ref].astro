---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getOrder } from '../../../lib/db';
import { naira, fmtDate, STATUS_COLORS, ORDER_STATUSES } from '../../../lib/format';
import { DELIVERY_OPTIONS } from '../../../data/catalog';

const { ref } = Astro.params;
const o = getOrder(ref);
if (!o) return Astro.redirect('/admin/orders');
---

<AdminLayout title={`Order ${o.ref}`} subtitle={`Placed ${fmtDate(o.createdAt)}`} active="orders">
  <div style="display:grid; grid-template-columns: 1.5fr 1fr; gap: 1.25rem; align-items: start" class="ord-grid">
    <div class="panel" style="padding: 1rem 1.25rem">
      <h2>Items</h2>
      <table class="tbl">
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th class="num">Total</th></tr></thead>
        <tbody>
          {o.items.map((it) => (
            <tr>
              <td>{it.name}</td>
              <td>{naira(it.price)}</td>
              <td>{it.qty}</td>
              <td class="num">{naira(it.price * it.qty)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="totals" style="max-width: 300px; margin-left: auto; margin-top: 1rem">
        <div class="row"><span>Subtotal</span><span>{naira(o.subtotal)}</span></div>
        <div class="row"><span>Delivery</span><span>{o.deliveryFee === 0 ? 'Free' : naira(o.deliveryFee)}</span></div>
        <div class="row grand"><span>Total</span><span>{naira(o.total)}</span></div>
      </div>
    </div>

    <div style="display:grid; gap:1.25rem">
      <div class="panel">
        <h2>Customer</h2>
        <p style="color: var(--ink-soft)">
          <b>{o.customer}</b><br />
          {o.phone}{o.email && <> · {o.email}</>}<br />
          {o.address}, {o.city}, {o.state}<br />
          <span style="font-size: 0.88rem; color: var(--ink-mute)">
            📦 {DELIVERY_OPTIONS[o.delivery]?.label ?? o.delivery}
          </span>
        </p>
      </div>

      <div class="panel">
        <h2>Status</h2>
        <p style="margin-bottom: 0.8rem">
          <span class="badge" style={`background:${STATUS_COLORS[o.status]}18;color:${STATUS_COLORS[o.status]}`}>{o.status}</span>
        </p>
        <form method="POST" action={`/api/admin/order-status?ref=${o.ref}`} style="display:flex; gap:0.6rem; flex-wrap:wrap">
          <select name="status" style="flex:1; min-width: 140px; border:1.5px solid var(--line-strong); border-radius:10px; padding:0.6rem 0.8rem">
            {ORDER_STATUSES.map((s) => <option value={s} selected={o.status === s}>{s}</option>)}
          </select>
          <button class="btn btn--primary btn--sm" type="submit">Update</button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  @media (max-width: 900px) { .ord-grid { grid-template-columns: 1fr !important; } }
</style>
