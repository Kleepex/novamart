---
import StoreLayout from '../../layouts/StoreLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProduct, getProducts } from '../../lib/db';
import { naira } from '../../lib/format';

const { id } = Astro.params;
const p = getProduct(id);
if (!p) return Astro.redirect('/');

const related = getProducts({ category: p.category }).filter((x) => x.id !== p.id).slice(0, 4);
const initials = p.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---

<StoreLayout title={`${p.name} — NovaMart Stores`} description={p.blurb}>
  <nav style="margin: 1.5rem 0; font-size: 0.9rem; color: var(--ink-mute)" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href={`/?cat=${encodeURIComponent(p.category)}`}>{p.category}</a> /{' '}
    <span style="color: var(--ink)">{p.name}</span>
  </nav>

  <section style="display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; margin-bottom: 3rem" class="pdp">
    <div
      style={`aspect-ratio: 1/0.85; border-radius: var(--r-xl); background: linear-gradient(140deg, ${p.color}, #fff); display:flex; align-items:center; justify-content:center; border: 1px solid var(--line)`}
    >
      <span style="font-size: 7rem; font-weight: 800; color: rgba(18,33,27,0.3); letter-spacing:-0.05em">{initials}</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem; align-content: start">
      <span class="chip is-active" style="align-self: flex-start">{p.category}</span>
      <h1 style="font-size: clamp(1.7rem, 3.5vw, 2.4rem); letter-spacing: -0.02em; line-height: 1.15">{p.name}</h1>
      <p style="color: var(--ink-soft); font-size: 1.05rem; max-width: 48ch">{p.blurb}</p>
      <p style="font-size: 2rem; font-weight: 800; color: var(--green-800)">{naira(p.price)}</p>
      <p style={`font-weight: 700; color: ${p.stock === 0 ? 'var(--red)' : p.stock < 10 ? 'var(--amber-600)' : 'var(--green-700)'}`}>
        {p.stock === 0 ? 'Currently sold out' : p.stock < 10 ? `Only ${p.stock} left in stock` : `In stock (${p.stock} available)`}
      </p>
      <div style="display: flex; gap: 0.9rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap">
        <span class="qty-ctl">
          <button type="button" onclick="const i=document.getElementById('pdp-qty');i.value=Math.max(1,+i.value-1)">−</button>
          <input id="pdp-qty" type="text" value="1" inputmode="numeric" aria-label="Quantity" />
          <button type="button" onclick="const i=document.getElementById('pdp-qty');i.value=Math.min(99,+i.value+1)">+</button>
        </span>
        <button class="btn btn--primary btn--lg" data-add-to-cart={p.id} disabled={p.stock === 0}>
          Add to cart
        </button>
        <a class="btn btn--ghost" href="/cart">Go to cart</a>
      </div>
      <div class="notice notice--info" style="margin-top: 0.75rem">
        🚚 Free pickup in Kano · ₦1,500 Lagos &amp; Kano metro · ₦3,000 nationwide (2–5 days). Pay on
        delivery or by bank transfer.
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section aria-label="Related products" style="margin-bottom: 3rem">
        <h2 style="margin-bottom: 1.25rem; letter-spacing: -0.01em">You may also like</h2>
        <div class="pgrid">{related.map((r) => <ProductCard p={r} />)}</div>
      </section>
    )
  }
</StoreLayout>
