---
import StoreLayout from '../layouts/StoreLayout.astro';
import { getProducts } from '../lib/db';
import { DELIVERY_OPTIONS, NIGERIAN_STATES } from '../data/catalog';

const products = getProducts();
const error = Astro.url.searchParams.get('error');
---

<StoreLayout title="Checkout — NovaMart Stores">
  <h1 style="margin: 2rem 0 1.25rem; letter-spacing: -0.01em">Checkout</h1>
  {error && <div class="notice notice--err">{error}</div>}

  <div class="panel empty" id="co-empty" hidden>
    <div class="big">🛒</div>
    <h2>Your cart is empty</h2>
    <p>Add some products before checking out.</p>
    <p style="margin-top: 1rem"><a class="btn btn--primary" href="/">Back to store</a></p>
  </div>

  <form method="POST" action="/api/orders" id="co-form" hidden>
    <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem; align-items: start" class="co-grid">
      <div class="panel">
        <h2>Delivery details</h2>
        <div class="fgrid">
          <div class="field full">
            <label for="c-name">Full name *</label>
            <input id="c-name" name="customer" required placeholder="e.g. Adaeze Okonkwo" autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-phone">Phone / WhatsApp *</label>
            <input id="c-phone" name="phone" required placeholder="+234 ..." autocomplete="tel" />
          </div>
          <div class="field">
            <label for="c-email">Email (optional)</label>
            <input id="c-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" />
          </div>
          <div class="field full">
            <label for="c-address">Street address *</label>
            <input id="c-address" name="address" required placeholder="House number, street, area" autocomplete="street-address" />
          </div>
          <div class="field">
            <label for="c-city">City *</label>
            <input id="c-city" name="city" required placeholder="e.g. Kano" />
          </div>
          <div class="field">
            <label for="c-state">State *</label>
            <select id="c-state" name="state" required>
              <option value="" disabled selected>Select state…</option>
              {NIGERIAN_STATES.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div class="field full">
            <label for="c-delivery">Delivery method *</label>
            <select id="c-delivery" name="delivery" required>
              {Object.entries(DELIVERY_OPTIONS).map(([value, o]) => (
                <option value={value}>
                  {o.label} — {o.fee === 0 ? 'Free' : '₦' + o.fee.toLocaleString('en-NG')}
                </option>
              ))}
            </select>
          </div>
          <div class="field full">
            <label for="c-notes">Order notes (optional)</label>
            <textarea id="c-notes" name="notes" placeholder="Landmark, preferred delivery time…"></textarea>
          </div>
        </div>
        <div class="notice notice--info" style="margin-top: 1.1rem">
          💳 <b>Payment:</b> pay on delivery, or by bank transfer after we confirm your order. (A
          real store would plug in Paystack / Flutterwave here.)
        </div>
      </div>

      <aside class="panel">
        <h2>Your order</h2>
        <table class="tbl" style="font-size: 0.9rem">
          <tbody id="co-items"></tbody>
        </table>
        <div class="totals" style="margin-top: 0.9rem">
          <div class="row"><span>Subtotal</span><span id="co-sub">₦0</span></div>
          <div class="row"><span>Delivery</span><span id="co-fee">₦0</span></div>
          <div class="row grand"><span>Total</span><span id="co-total">₦0</span></div>
        </div>
        <input type="hidden" name="items" id="co-items-input" />
        <button type="submit" class="btn btn--amber btn--lg btn--block" style="margin-top: 1.25rem">
          Place order
        </button>
        <p style="font-size: 0.8rem; color: var(--ink-mute); text-align: center; margin-top: 0.7rem">
          Secure your order with WhatsApp, bank transfer or cash on delivery.
        </p>
      </aside>
    </div>
  </form>

  <script id="nm-products" type="application/json" set:html={JSON.stringify(products)}></script>
  <script id="nm-fees" type="application/json" set:html={JSON.stringify(Object.fromEntries(Object.entries(DELIVERY_OPTIONS).map(([k, v]) => [k, v.fee])))}></script>
  <script>
    (() => {
      const catalog = JSON.parse(document.getElementById('nm-products').textContent);
      const fees = JSON.parse(document.getElementById('nm-fees').textContent);
      const byId = Object.fromEntries(catalog.map((p) => [p.id, p]));
      const naira = (n) => '₦' + n.toLocaleString('en-NG');
      const form = document.getElementById('co-form');
      const deliverySel = document.getElementById('c-delivery');

      const render = () => {
        const cart = window.NMCart.read();
        const ids = Object.keys(cart).filter((id) => byId[id]);
        const has = ids.length > 0;
        document.getElementById('co-empty').hidden = has;
        form.hidden = !has;
        if (!has) return;

        let subtotal = 0;
        const rows = ids.map((id) => {
          const p = byId[id];
          const line = p.price * cart[id];
          subtotal += line;
          return `<tr><td>${p.name} <span style="color:var(--ink-mute)">× ${cart[id]}</span></td><td class="num">${naira(line)}</td></tr>`;
        });
        document.getElementById('co-items').innerHTML = rows.join('');
        const fee = fees[deliverySel.value] || 0;
        document.getElementById('co-sub').textContent = naira(subtotal);
        document.getElementById('co-fee').textContent = fee === 0 ? 'Free' : naira(fee);
        document.getElementById('co-total').textContent = naira(subtotal + fee);
        document.getElementById('co-items-input').value = JSON.stringify(
          ids.map((id) => ({ id, qty: cart[id] })),
        );
      };

      deliverySel.addEventListener('change', render);
      render();
    })();
  </script>
</StoreLayout>

<style>
  @media (max-width: 860px) {
    .co-grid { grid-template-columns: 1fr !important; }
  }
</style>
