---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getProducts } from '../../../lib/db';
import { naira } from '../../../lib/format';
import { CATEGORIES } from '../../../data/catalog';

const q = Astro.url.searchParams.get('q') ?? '';
const cat = Astro.url.searchParams.get('cat') ?? '';
const products = getProducts({ q, category: cat, sort: 'name' });
const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');
---

<AdminLayout title="Products" subtitle={`${products.length} product${products.length === 1 ? '' : 's'} in catalog`} active="products">
  <Fragment slot="actions">
    <a href="/admin/products/new" class="btn btn--primary">+ New product</a>
  </Fragment>

  {saved && <div class="notice notice--ok">Product saved successfully. ✅</div>}
  {deleted && <div class="notice notice--info">Product removed from catalog.</div>}

  <form method="get" class="chip-bar" style="margin-top: 0">
    <input type="search" name="q" value={q} placeholder="Search…" style="border: 1.5px solid var(--line-strong); border-radius: 999px; padding: 0.55rem 1.1rem; min-width: 210px" />
    <a class={`chip ${!cat ? 'is-active' : ''}`} href="/admin/products">All</a>
    {CATEGORIES.map((c) => (
      <a class={`chip ${cat === c ? 'is-active' : ''}`} href={`/admin/products?cat=${encodeURIComponent(c)}`}>{c}</a>
    ))}
    <noscript><button class="btn btn--ghost btn--sm">Filter</button></noscript>
  </form>

  <div class="panel" style="padding: 0.5rem 1.25rem">
    <table class="tbl">
      <thead>
        <tr><th>Product</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th><th></th></tr>
      </thead>
      <tbody>
        {products.map((p) => (
          <tr>
            <td>
              <div style="display:flex; gap:0.7rem; align-items:center">
                <span class="avatar-tile" style={`background:${p.color}`}>{p.name[0]}</span>
                <span>
                  <b>{p.name}</b><br />
                  <span style="color:var(--ink-mute); font-size:0.82rem">{p.id}</span>
                </span>
              </div>
            </td>
            <td style="color:var(--ink-soft)">{p.category}</td>
            <td class="num"><b>{naira(p.price)}</b></td>
            <td class="num">
              <span class="badge" style={`background:${p.stock === 0 ? '#b91c1c18' : p.stock < 10 ? '#d9770618' : '#15803d18'}; color:${p.stock === 0 ? '#b91c1c' : p.stock < 10 ? '#d97706' : '#15803d'}`}>
                {p.stock}
              </span>
            </td>
            <td class="num" style="white-space: nowrap">
              <a href={`/admin/products/${p.id}`} class="btn btn--ghost btn--sm">Edit</a>{' '}
              <form method="POST" action={`/api/admin/product-delete?id=${p.id}`} style="display:inline" onsubmit="return confirm('Delete this product?')">
                <button class="btn btn--danger btn--sm">Delete</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
